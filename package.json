{
    "name":  "deeptunisia",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "deeptunisia.org - an open-source, source-backed atlas of political, military, security and economic power in Tunisia, 1956-2026",
    "scripts":  {
                    "data":  "tsx scripts/build-data.ts && tsx scripts/build-media.ts",
                    "data:watch":  "tsx watch scripts/build-data.ts",
                    "dev":  "npm run data \u0026\u0026 vite dev --port 5173 --strictPort",
                    "start":  "npm run data \u0026\u0026 tsx scripts/dev-all.ts",
                    "build":  "npm run data \u0026\u0026 vite build \u0026\u0026 tsx scripts/build-landing.ts",
                    "preview":  "vite preview",
                    "check":  "npm run data \u0026\u0026 svelte-kit sync \u0026\u0026 svelte-check --tsconfig ./tsconfig.json",
                    "test":  "tsx scripts/test-data.ts \u0026\u0026 tsx scripts/test-validators.ts \u0026\u0026 tsx scripts/test-pipeline.ts \u0026\u0026 tsx scripts/test-media.ts \u0026\u0026 tsx scripts/test-ui.ts \u0026\u0026 tsx scripts/test-i18n.ts \u0026\u0026 tsx scripts/test-match.ts \u0026\u0026 tsx scripts/test-markup.ts \u0026\u0026 tsx scripts/test-feed.ts \u0026\u0026 tsx scripts/test-emit.ts \u0026\u0026 tsx scripts/test-encoding.ts \u0026\u0026 tsx scripts/test-parameters.ts \u0026\u0026 tsx scripts/test-paper.ts \u0026\u0026 tsx scripts/test-community.ts \u0026\u0026 tsx scripts/test-api.ts",
                    "test:markup":  "tsx scripts/test-markup.ts",
                    "test:i18n":  "tsx scripts/test-i18n.ts",
                    "test:data":  "tsx scripts/test-data.ts",
                    "test:validators":  "tsx scripts/test-validators.ts",
                    "test:pipeline":  "tsx scripts/test-pipeline.ts",
                    "test:media":  "tsx scripts/test-media.ts",
                    "test:parameters":  "tsx scripts/test-parameters.ts",
                    "test:paper":  "tsx scripts/test-paper.ts",
                    "mutation":  "tsx scripts/mutation-test.ts",
                    "test:match":  "tsx scripts/test-match.ts",
                    "test:feed":  "tsx scripts/test-feed.ts",
                    "test:emit":  "tsx scripts/test-emit.ts",
                    "test:encoding":  "tsx scripts/test-encoding.ts",
                    "test:community":  "tsx scripts/test-community.ts",
                    "test:api":  "tsx scripts/test-api.ts",
                     "feed":  "tsx scripts/fetch-feed.ts",
                     "fetch:trade":  "tsx scripts/fetch-trade.ts",
                     "fetch:debt":  "tsx scripts/fetch-debt.ts",
                     "fetch:wdi":  "tsx scripts/fetch-wdi.ts",
                    "admin":  "npm run data \u0026\u0026 tsx scripts/admin.ts",
                    "community":  "tsx community/server.ts",
                    "proposals":  "tsx scripts/apply-proposals.ts",
                    "smoke":  "tsx scripts/smoke.ts",
                    "deploy":  "npm run build \u0026\u0026 wrangler deploy",
                    "agents:discover":  "tsx scripts/agents.ts",
                    "agents:outbox":  "tsx scripts/agents.ts --list",
                    "sensitivity":  "tsx scripts/sensitivity.ts"
                },
    "devDependencies":  {
                            "@sveltejs/adapter-static":  "3.0.10",
                            "@sveltejs/kit":  "2.70.1",
                            "@sveltejs/vite-plugin-svelte":  "7.2.0",
                            "@types/d3-geo":  "3.1.1",
                            "@types/d3-scale":  "4.0.9",
                            "@types/d3-time":  "3.0.4",
                            "@types/geojson":  "7946.0.16",
                            "@types/node":  "^26.1.1",
                            "@types/topojson-client":  "3.1.5",
                            "@types/topojson-specification":  "1.0.5",
                            "fast-xml-parser":  "^5.10.1",
                            "playwright":  "^1.56.1",
                            "svelte":  "5.56.8",
                            "svelte-check":  "4.7.3",
                            "tsx":  "4.23.1",
                            "typescript":  "5.9.3",
                            "vite":  "8.1.5"
                        },
    "dependencies":  {
                         "@noble/ed25519":  "3.1.0",
                         "@scure/bip39":  "2.2.0",
                         "d3-array":  "3.2.4",
                         "d3-geo":  "3.1.1",
                         "d3-scale":  "4.0.2",
                         "d3-shape":  "3.2.0",
                         "graphology":  "0.26.0",
                         "graphology-metrics":  "2.4.0",
                         "minisearch":  "7.2.0",
                         "topojson-client":  "3.1.0",
                         "world-atlas":  "2.0.2",
                         "yaml":  "2.9.0",
                         "zod":  "4.4.3"
                     }
}
